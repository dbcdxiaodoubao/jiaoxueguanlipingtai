<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mashang.mapper.TaskMapper">

    <resultMap id="listStudentTasksMap" type="taskVo" autoMapping="true">
        <id property="taskId" column="task_id"></id>
        <collection property="studentTests" ofType="testListTaskVo" autoMapping="true">
            <result property="testId" column="test_id"></result>
        </collection>
    </resultMap>
    <select id="listStudentTasks" resultMap="listStudentTasksMap">
        SELECT
            t1.task_id,
            t1.task_name,
            t3.test_id,
            t3.test_name
        FROM
            ms_task AS t1
                LEFT JOIN
            ms_task_test AS t2
            ON
                t1.task_id = t2.task_id AND
                t2.del_flag = 0
                LEFT JOIN
            ms_test AS t3
            ON
                t2.test_id = t3.test_id AND
                t3.del_flag = 0
        WHERE
            t1.del_flag = 0 AND
            t1.grade = #{grade}
    </select>
</mapper>
