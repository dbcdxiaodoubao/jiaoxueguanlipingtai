<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mashang.mapper.StuLogininfoMapper">

    <select id="list" resultType="stuLoginInfoVo">
        select *
        from sys_logininfor
        where user_name = #{userName}
    </select>


    <select id="getUserActivity" resultType="userActivity">
        SELECT
            DATE(login_time) AS date ,
            COUNT(DISTINCT user_name) AS user_sum
        FROM sys_logininfor
        GROUP BY DATE(login_time)
        ORDER BY DATE(login_time) ;
    </select>
</mapper>