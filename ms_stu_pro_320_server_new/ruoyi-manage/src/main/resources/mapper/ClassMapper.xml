<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mashang.mapper.ClassMapper">

    <select id="selectClassIds" resultType="java.lang.Integer" parameterType="java.lang.Long">
        select class_id from ms_class where teacher_id=#{userId}
    </select>
</mapper>
